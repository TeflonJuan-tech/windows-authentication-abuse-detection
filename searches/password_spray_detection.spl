# Password spray detection
# Logic: Multiple users targeted with few attempts per user
# Event ID: 4625

index=main sourcetype=XmlWinEventLog:Security "<EventID>4625</EventID>"
| rex field=_raw "Data Name='TargetUserName'>(?<target_user>[^<]+)<"
| rex field=_raw "Data Name='IpAddress'>(?<src_ip>[^<]+)<"
| eval src_ip=coalesce(src_ip,"unknown")
| bin _time span=10m
| stats count as failures dc(target_user) as distinct_users values(target_user) as users by _time host src_ip
| where distinct_users >= 3 AND failures >= 3
| sort - failures
